# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vs/
.vscode/
.idea/
*.suo
*.user

# Claude Code — 도구 설정/캐시는 어느 깊이에 있든 전부 ignore
# (CLAUDE.md는 프로젝트 가이드라인 문서라 별도 유지)
**/.claude/
**/.mcp.json

# Unreal Engine — build outputs (any depth)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Unreal Engine — auto-generated project / VS files
*.sln
*.VC.db
*.VC.opendb
*.opensdf
*.sdf

# Crash dumps
*.dmp
*.dmp.zip

# Node.js
node_modules/
*.log
dist/
build/
coverage/
.nyc_output/

# Env (commit only .env.example)
.env
.env.local
.env.*.local

# Builds output — keep placeholder only
Builds/Client/*
!Builds/Client/.gitkeep
Builds/Server/*
!Builds/Server/.gitkeep

# Third-party Unreal plugins (externally managed — see PROJECT_PLAN.md MCP 섹션)
D1/Plugins/Monolith/

# Unreal Engine — packaging output (Package Project 결과, GitHub 100MB 한도 초과 파일 포함)
D1/Package/

# Unreal Content — 개인 확인용 에셋 (로컬 PC 전용, Git/LFS 양쪽 모두 제외)
D1/Content/Externals/

# Stray
$null

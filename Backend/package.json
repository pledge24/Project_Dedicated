{
  "name": "d1-backend",
  "version": "0.1.0",
  "description": "D1 봄버맨 백엔드 (인증/매칭/랭킹)",
  "type": "module",
  "main": "src/index.ts",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "tsx scripts/migrate.ts up",
    "migrate:status": "tsx scripts/migrate.ts status",
    "migrate:make": "tsx scripts/migrate.ts make",
    "db:init": "tsx scripts/db-init.ts",
    "match:sim": "tsx scripts/match-sim.ts",
    "match:elo": "tsx scripts/match-elo.ts",
    "match:result-sim": "tsx scripts/match-result-sim.ts",
    "match:bots": "tsx scripts/match-bots.ts",
    "ranking:sim": "tsx scripts/ranking-sim.ts",
    "auth:sim": "tsx scripts/auth-session-sim.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}

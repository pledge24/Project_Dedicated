# 서버
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=changeme
DB_NAME=d1

# JWT
JWT_SECRET=please-change-this-to-32-bytes-min-secret
JWT_TTL=24h

# Rate Limit (windowMs 동안 허용 요청 수)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_RESULT_MAX=30
RATE_LIMIT_RANKING_MAX=60
RATE_LIMIT_WS_MAX=100

# 매칭 큐 (윈도우 단위=점수, 주기 단위=ms)
MATCH_PLAYERS_PER_MATCH=4
MATCH_BASE_WINDOW=200
MATCH_EXPAND_RATE=50
MATCH_MAX_WINDOW=2000
MATCH_CYCLE_MS=1000
MATCH_HEARTBEAT_MS=30000

# 봇전(Bot-Fill): 이 시간 넘게 매치가 안 잡히면 봇 3명과 즉시 게임(DS 활성 필요). 봇 점수=플레이어±spread.
MATCH_BOT_FILL_ENABLED=true
MATCH_BOT_FILL_MS=30000
MATCH_BOT_RATING_SPREAD=100

# 매치 결과 점수(ELO)
MATCH_ELO_K=32
MATCH_SCORE_FLOOR=0

# stub 게임 서버 (MATCH_DS_ENABLED=false일 때 클라에 줄 주소)
MATCH_STUB_HOST=127.0.0.1
MATCH_STUB_PORT=7777

# Dedicated Server 할당 (true면 매치당 D1Server.exe spawn)
MATCH_DS_ENABLED=false
MATCH_DS_MAP=/Game/D1/Maps/MP_Ingame
MATCH_DS_HOST=127.0.0.1
MATCH_DS_PORT_MIN=7777
MATCH_DS_PORT_MAX=7787
MATCH_DS_READY_TIMEOUT_MS=30000
MATCH_DS_MAX_LIFETIME_MS=900000
# MATCH_DS_ENABLED=true 일 때 필수 — D1Server.exe 절대경로(머신별)
# MATCH_DS_EXE=C:/path/to/D1/Packaged/Server/WindowsServer/D1Server.exe

# 랭킹 조회 페이지네이션 (offset은 MySQL이 그만큼 스캔 후 버리므로 상한 필요)
RANKING_DEFAULT_LIMIT=50
RANKING_MAX_LIMIT=100
RANKING_MAX_OFFSET=10000
